# ---------------------------------------------------------------------------
# family-dash configuration
# Copy to .env and adjust. `docker compose` reads .env automatically.
# ---------------------------------------------------------------------------

# --- Published port -------------------------------------------------------
# The only port exposed to your LAN. Browse to http://<pi-address>:${WEB_PORT}
WEB_PORT=8080

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=familydash
POSTGRES_USER=familydash
POSTGRES_PASSWORD=change-me-before-first-boot
# Exposed on the host for debugging only; comment out the db `ports:` entry
# in docker-compose.yml to keep Postgres entirely internal.
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
API_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# --- Locale ---------------------------------------------------------------
# Used for cron schedules, date rendering and weather timezone resolution.
TZ=America/Vancouver

# --- Default weather location --------------------------------------------
# Overridable in the Settings page once the app is running.
DEFAULT_LATITUDE=49.2827
DEFAULT_LONGITUDE=-123.1207
DEFAULT_LOCATION_NAME=Vancouver
# metric | imperial
DEFAULT_UNITS=metric

# --- Media library --------------------------------------------------------
# Host path mounted into the API container. Point this at a USB drive or an
# NFS mount on the Pi if your photo library lives elsewhere.
MEDIA_PATH=./media

# The uid/gid the API runs as, which must own (or be able to write) MEDIA_PATH.
# 1000 is the first account on a Raspberry Pi and needs no change for the
# usual install. If MEDIA_PATH lives on a drive owned by somebody else, run
# `id -u` and `id -g` as that owner and put the numbers here. The media probe
# in /healthCheck reports it plainly when this is wrong.
API_UID=1000
API_GID=1000

# --- Optional API keys ----------------------------------------------------
# Weather works with no key at all (Open-Meteo). These are only needed if you
# switch providers or enable Google Calendar in Settings.
OPENWEATHERMAP_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- notifications ---------------------------------------------------------
# The ntfy server runs in this stack. Phones subscribe to it directly, so this
# has to be an address they can reach ie the Pi's LAN address, not localhost
#
#   NTFY_PUBLIC_URL=http://192.168.1.50:2586
#
# Leave it empty and notifications still send, but the subscribe QR codes in
# Settings will have no server to point at.
NTFY_PUBLIC_URL=
NTFY_PORT=2586

# Only if you have locked the ntfy server down with an access token, which the
# README explains is worth doing before exposing it beyond your LAN.
NTFY_TOKEN=
