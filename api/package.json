{
  "name": "family-dash-api",
  "version": "0.1.0",
  "description": "Family dashboard API \u2014 decorator-driven Express service over PostgreSQL",
  "license": "MIT",
  "private": true,
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch lib/index.ts",
    "start": "node build/index.js",
    "build": "tsc && node scripts/copy-assets.mjs",
    "clean": "rimraf build",
    "migrate": "tsx lib/db/cli.ts",
    "lint": "eslint lib test",
    "lint:fix": "eslint lib test --fix",
    "format": "prettier --write \"{lib,test}/**/*.ts\"",
    "format:check": "prettier --check \"{lib,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ical.js": "^2.2.1",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  }
}
